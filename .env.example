# Domain (dùng cho Caddy trên VPS, local để localhost)
DOMAIN=localhost

# PostgreSQL Database
POSTGRES_USER=podoc
POSTGRES_PASSWORD=podoc_secure_db_pass_123
POSTGRES_DB=podoc
DATABASE_URL=postgresql+asyncpg://podoc:podoc_secure_db_pass_123@postgres:5432/podoc

# Quản trị viên (Khởi tạo tài khoản duy nhất khi khởi động lần đầu)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=podoc_admin_password_change_me

# JWT Authentication
JWT_SECRET=super_secure_random_jwt_secret_key_at_least_32_chars_long
ACCESS_TOKEN_EXPIRE_DAYS=30

# Giới hạn số lần đăng nhập sai theo IP (chống brute force)
RATE_LIMIT_LOGIN=5/minute
