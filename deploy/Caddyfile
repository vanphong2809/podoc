{$DOMAIN:localhost} {
    # Tự động cấp và gia hạn chứng chỉ SSL Let's Encrypt / ZeroSSL

    # Cho phép tải lên các tệp tin/video dung lượng lớn (tối đa 10GB)
    request_body {
        max_size 10GB
    }

    # Reverse proxy tới container Backend FastAPI
    reverse_proxy api:8000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Bật nén phản hồi gzip / zstd
    encode zstd gzip

    # Log truy cập (tự động loại trừ dữ liệu nhạy cảm)
    log {
        output stdout
        format console
    }
}
